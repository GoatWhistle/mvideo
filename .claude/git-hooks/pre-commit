#!/usr/bin/env bash
set -euo pipefail

here=$(dirname "$0")
root=$(git rev-parse --show-toplevel)
stop=$(<"$here/stopwords")

if git diff --cached --quiet -- context/; then :; else
  python3 "$root/.claude/scripts/context_budget.py" --staged >/dev/null || exit 1
fi

if ! git diff --cached --quiet -- backend/; then
  command -v uv >/dev/null || { echo 'pre-commit: uv is required for backend unit tests' >&2; exit 1; }
  (cd "$root/backend" && uv run --frozen pytest tests/unit -q --no-header -p no:cacheprovider) \
    || { echo 'pre-commit: backend unit tests failed' >&2; exit 1; }
fi

excludes=(
  ':(exclude,glob).claude/**' ':(exclude,glob)**/.claude/**'
  ':(exclude,glob).agents/**' ':(exclude,glob)**/.agents/**'
  ':(exclude,glob)**/AGENTS.md' ':(exclude,glob)**/CLAUDE.md'
  ':(exclude,glob)AGENTS.md' ':(exclude,glob)CLAUDE.md'
  ':(exclude,glob)**/PROMPT-*' ':(exclude,glob)**/TASK-*'
  ':(exclude,glob)context/**' ':(exclude).gitignore' ':(exclude).mcp.json'
)
if [[ -f $root/.claude/scrub-paths ]]; then
  while IFS= read -r p; do
    [[ -n $p ]] && excludes+=(":(exclude,glob)${p%/}/**" ":(exclude)$p")
  done <"$root/.claude/scrub-paths"
fi

added=$(git diff --cached -U0 --no-color --diff-filter=ACMR -- . "${excludes[@]}" \
  | awk '/^\+\+\+ /{f=substr($0,7); next}
         /^@@/{split($3,a,","); n=substr(a[1],2)+0; next}
         /^\+/{print f"\t"n"\t"substr($0,2); n++}')

hits=$(printf '%s\n' "$added" | grep -iE "$stop" || true)
[[ -n $hits ]] || exit 0

report=
while IFS=$'\t' read -r file line text; do
  inside=$(git show ":$file" | awk -v t="$line" '
    /<!-- scrub:start -->/{s=1} NR==t{print s; exit} /<!-- scrub:end -->/{s=0}')
  [[ $inside == 1 ]] || report+="$file:$line: $text"$'\n'
done <<<"$hits"

if [[ -n $report ]]; then
  printf 'pre-commit: agent mention in added lines:\n%s' "$report" >&2
  exit 1
fi
